# Smart Face Recognition Security System — Configuration
# Copy this file to .env and fill in your real values.

# ── Camera ─────────────────────────────────────────────────────────────────────
# RTSP stream URL from your EZVIZ C6N camera, or "0" for local webcam
RTSP_URL=rtsp://admin:password@192.168.1.100:554/stream1
FRAME_SKIP=4
RTSP_RESIZE_WIDTH=640
RTSP_MAX_FPS=15

# ── Face Recognition ────────────────────────────────────────────────────────────
# FACE_MATCH_THRESHOLD: "distance" threshold — lower = stricter (0.0–1.0)
# A value of 0.4 means cosine similarity must be >= 0.6 to match
FACE_MATCH_THRESHOLD=0.4
FACE_DETECT_THRESHOLD=0.5

# ── Security Alert Logic ────────────────────────────────────────────────────────
# Seconds between repeated unknown-face alerts (prevents notification spam)
UNKNOWN_COOLDOWN_SEC=120

# ── Telegram Bot ────────────────────────────────────────────────────────────────
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your personal Telegram user ID (get from @userinfobot)
TELEGRAM_ADMIN_ID=your_admin_id_here
# Your public ngrok/Cloudflare tunnel URL (no trailing slash)
TELEGRAM_WEBHOOK_URL=https://your-tunnel-url.ngrok-free.app

# ── FastAPI Server ──────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── SaaS Multi-tenancy (future) ────────────────────────────────────────────────
CAMERA_ID=cam-01
TENANT_ID=default

# ── Paths ──────────────────────────────────────────────────────────────────────
DB_PATH=./security.db
SNAPSHOTS_DIR=./snapshots
MODEL_DIR=./models
